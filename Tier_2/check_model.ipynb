    "import subprocess\n",
    "\n",
    "result = subprocess.run(\n",
    "    [\"ollama\", \"list\"],\n",
    "    capture_output=True,\n",
    "    text=True,\n",
    "    check=True,\n",
    ")\n",
    "\n",
    "model_name = next(\n",
    "    line.split()[0]\n",
    "    for line in result.stdout.splitlines()\n",
    "    if \"Llama-3.2-3B-Instruct\" in line\n",
    ")\n",
    "print(f\"Found: {model_name}\")"
   ]
  }

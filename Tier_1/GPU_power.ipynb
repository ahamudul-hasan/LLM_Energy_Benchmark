   "source": [
    "from pynvml import *\n",
    "\n",
    "nvmlInit()\n",
    "\n",
    "handle = nvmlDeviceGetHandleByIndex(0)\n",
    "\n",
    "power = nvmlDeviceGetPowerUsage(handle)\n",
    "\n",
    "print(f\"GPU Power Usage: {power / 1000:.2f} W\")\n",
    "\n",
    "nvmlShutdown()"
   ]
  },
